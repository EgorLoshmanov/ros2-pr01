    "broken_graph": [
      "export ROS_DOMAIN_ID=17",
      "ros2 run turtlesim turtle_teleop_key",
      "ROS_DOMAIN_ID=17 ros2 node list --no-daemon --spin-time 2",
      "ROS_DOMAIN_ID=17 timeout --signal=INT --kill-after=2s 5s ros2 topic echo /turtle1/pose turtlesim_msgs/msg/Pose --once"
    ],
    "recovery": [
      "export ROS_DOMAIN_ID=16",
      "ros2 run turtlesim turtle_teleop_key",
      "ROS_DOMAIN_ID=16 ros2 node list --no-daemon --spin-time 2",
      "ROS_DOMAIN_ID=16 timeout --signal=INT --kill-after=2s 5s ros2 topic echo /turtle1/pose turtlesim_msgs/msg/Pose --once"
    ]
  },
